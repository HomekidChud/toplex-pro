{
  "name": "toplex-pro",
  "productName": "Toplix Pro",
  "version": "1.9.1",
  "description": "Toplix Pro — a fast, focused AI coding assistant for macOS, Windows, Linux and Android. Connect ChatGPT, Codex, Claude, OpenRouter or any OpenAI-compatible endpoint.",
  "author": "HomekidChud",
  "license": "LicenseRef-LICENSE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.homekidchud.toplexpro",
    "productName": "Toplix Pro",
    "protocols": [
      {
        "name": "Toplix Pro sign-in",
        "schemes": [
          "toplex"
        ],
        "role": "Viewer"
      }
    ],
    "copyright": "Copyright © 2026 HomekidChud. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Toplix-Pro-${version}-${arch}.dmg"
    },
    "dmg": {
      "title": "Toplix Pro ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Toplix-Pro-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "HomekidChud <HomekidChud@users.noreply.github.com>",
      "synopsis": "AI coding assistant",
      "artifactName": "Toplix-Pro-${version}-linux-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/HomekidChud/toplex-pro"
}
